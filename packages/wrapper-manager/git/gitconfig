[alias]
	co = "checkout"
	cp = "cherry-pick"
	pushfwl = "push --force-with-lease"

[core]
        # :BUG: Resolve path to binary in /nix/store.
	# pager = "delta"

[extraConfig "credential"]
	helper = "store"

[extraConfig "init"]
	defaultBranch = "main"

[extraConfig "push"]
	autoSetupRemote = true

[filter "lfs"]
	clean = "git-lfs clean -- %f"
	process = "git-lfs filter-process"
	required = true
	smudge = "git-lfs smudge -- %f"

[gpg]
	format = "openpgp"

[gpg "openpgp"]
